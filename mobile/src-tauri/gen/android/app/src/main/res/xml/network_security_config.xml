<?xml version="1.0" encoding="utf-8"?>
<!-- The WebView talks to the in-process engine over http://127.0.0.1:<port>.
     Permit cleartext for loopback ONLY — everything else keeps the platform
     default (no cleartext), in release builds included. This overrides the
     template's usesCleartextTraffic placeholder wherever both apply. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
